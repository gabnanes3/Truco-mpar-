{
  "name": "truco-impar",
  "version": "1.0.0",
  "private": true,
  "description": "Truco online para número ímpar de jogadores (todos contra todos).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node tools/serve.js",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"tests/engine/**/*.test.js\" \"tests/net/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "peer": "1.0.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3"
  }
}
